# LLM Provider (gemini, anthropic, openai)
LLM_PROVIDER=gemini

# API Keys (never commit real keys!)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# NCBI (for PubMed, higher rate limit with key)
NCBI_API_KEY=

# Database
DATABASE_URL=postgresql://bioevidence:bioevidence@localhost:5432/bioevidence

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns

# Embedding model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-base

# Extractor base model
EXTRACTOR_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# Retrieval config
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=50
RRF_K=60

# Agent config
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=30
AGENT_TOKEN_BUDGET=8000

# Forecasting
FORECAST_TEST_START_YEAR=2020

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173"]

# Rate limits
NCBI_RATE_LIMIT=3
OPENAFDA_RATE_LIMIT=10

# Seed
SEED=42